# =============================================================================
# hand-gesture-control — .gitignore
# پروژه سی++ / أوبنencv مترجمّة على ويندوز
# =============================================================================

# --- أسرار وإعدادات محلية (لا تُرفع أبداً إلى الريپو الخاص) ---
.env
.env.local
*.env

# --- ملفات البناء (CMake / MSVC) ---
build/
*/build/
CMakeFiles/
CMakeCache.txt
CMakePresets.json.user
install_manifest.txt
CTestTestfile.cmake
*.cmake

# --- مخرجات مترجم مايكروسوفت / Visual Studio ---
*.exe
*.dll
*.obj
*.pdb
*.idb
*.ilk
*.exp
*.lib
*.tlog
*.lastbuildstate
*.recipe
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.opensdf
*.sdf
*.suo
*.vscode/
.vs/
Debug/
Release/
x64/
x86/

# --- مخرجات التطبيق وقت التشغيل ---
session_transcript.txt
telemetry_log.csv
*.csv
*.log

# --- أنظمة التشغيل ---
Thumbs.db
DS_Store
$RECYCLE.BIN/

# --- أماكن مؤقتة ---
tmp/
temp/
*.tmp

